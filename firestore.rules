rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    match /students/{studentId} {
      allow read, create, update, delete: if isAdmin();
      match /homeworks/{homeworkId} { allow read, write: if isAdmin(); }
      match /transactions/{transactionId} { allow read, write: if isAdmin(); }
    }

    match /publicProfiles/{publicToken} {
      allow get: if resource.data.active == true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
